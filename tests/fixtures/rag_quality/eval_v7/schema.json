{
  "dataset_name": "local_multi_kb_eval_v7_holdout_regression",
  "evaluation_mode": "healthy",
  "required_fields": [
    "case_id",
    "dataset",
    "kb_id",
    "question",
    "source_doc",
    "source_locator",
    "expected_scope_type",
    "expected_isolation_level",
    "modality",
    "answer_style",
    "difficulty",
    "category",
    "answerable",
    "expected_keypoints",
    "required_evidence_docs",
    "expected_source_count",
    "preview_required",
    "preview_terms",
    "forbidden_terms",
    "judge_focus"
  ],
  "allowed_modalities": [
    "markdown",
    "pdf",
    "image_ocr"
  ],
  "allowed_answer_styles": [
    "fact",
    "policy",
    "comparison",
    "refusal"
  ],
  "allowed_difficulties": [
    "simple",
    "medium",
    "complex"
  ],
  "allowed_categories": [
    "role_lookup",
    "timeline_sla",
    "cross_document",
    "evidence_operation",
    "process_boundary",
    "long_document",
    "no_evidence",
    "scope_contract"
  ],
  "allowed_scope_types": [
    "single_kb"
  ],
  "allowed_isolation_levels": [
    "physical_isolated"
  ],
  "allowed_judge_dimensions": [
    "factual_accuracy",
    "completeness",
    "citation_accuracy",
    "groundedness",
    "refusal_correctness"
  ],
  "quality_gates": {
    "minimum_total_cases": 24,
    "minimum_cases_per_modality": 8,
    "minimum_cases_per_difficulty": 6,
    "minimum_no_evidence_cases": 3,
    "minimum_preview_required_cases": 21,
    "minimum_refusal_cases_per_modality": 1,
    "minimum_cases_per_answer_style": 3,
    "minimum_cases_per_category": 1,
    "minimum_cases_per_judge_dimension": 3,
    "minimum_negative_contract_cases_per_modality": 2
  },
  "run_gates": {
    "scope_pass_rate_min": 1.0,
    "average_keypoint_coverage_min": 0.85,
    "evidence_hit_rate_min": 0.95,
    "preview_resolvable_rate_min": 0.95,
    "source_count_match_rate_min": 0.95,
    "forbidden_term_clean_rate_min": 1.0
  },
  "rubric_dimensions": {
    "factual_accuracy": {
      "weight": 0.3,
      "min": 0.85
    },
    "completeness": {
      "weight": 0.25,
      "min": 0.75
    },
    "citation_accuracy": {
      "weight": 0.2,
      "min": 0.9
    },
    "groundedness": {
      "weight": 0.15,
      "min": 0.9
    },
    "refusal_correctness": {
      "weight": 0.1,
      "min": 0.95
    }
  },
  "required_refusal_categories": [
    "no_evidence"
  ],
  "required_refusal_markers_by_category": {
    "no_evidence": [
      "No confirmable information",
      "knowledge base"
    ]
  },
  "required_negative_contract_categories": [
    "process_boundary",
    "scope_contract"
  ],
  "required_negative_contract_markers_by_category": {
    "process_boundary": [
      "folder",
      "knowledge base"
    ],
    "scope_contract": [
      "effective_kb_ids",
      "single_kb"
    ]
  }
}
