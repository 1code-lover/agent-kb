# 统一仓库文本文件行尾，减少 Windows / macOS / Linux 协作时的 CRLF/LF 噪音。
* text=auto

# Windows 脚本保留 CRLF，避免 PowerShell / cmd 体验退化。
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 代码、文档与配置统一为 LF，便于 diff 与容器/CI 复现。
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.css text eol=lf
*.html text eol=lf

# 常见二进制文件禁止行尾转换。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
